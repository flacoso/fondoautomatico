<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fondo Automático" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cambia automáticamente las fotos de una carpeta como fondo del móvil." android:textSize="16sp" android:layout_marginBottom="24dp"/>
<Button android:id="@+id/selectFolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Seleccionar carpeta de fotos"/>
<TextView android:id="@+id/folderText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ninguna carpeta seleccionada" android:padding="12dp" android:layout_marginBottom="20dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Intervalo" android:textStyle="bold"/>
<Spinner android:id="@+id/intervalSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Orden de las fotos" android:textStyle="bold"/>
<Spinner android:id="@+id/modeSpinner" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp"/>
<Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▶ Iniciar cambio automático"/>
<Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="■ Detener" android:layout_marginTop="10dp"/>
<Button android:id="@+id/batteryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Permitir ejecución en segundo plano" android:layout_marginTop="20dp"/>
</LinearLayout></ScrollView>
